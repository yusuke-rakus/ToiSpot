{
  "name": "toilet-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-toilet-map-tests --only auth,firestore \"vitest run --project rules\"",
    "emulators": "docker compose up --build --wait firebase",
    "emulators:stop": "docker compose stop firebase",
    "emulators:logs": "docker compose logs --follow firebase",
    "emulators:local": "firebase emulators:start --project demo-toilet-map --only auth,firestore",
    "test:rules:docker": "FIRESTORE_EMULATOR_HOST=127.0.0.1:18081 vitest run --project rules",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "pnpm docs:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "docs:dependencies": "node scripts/update-dependencies.mjs",
    "seed": "node scripts/seed.ts",
    "stores:cleanup": "node scripts/cleanup-stores.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "7.0.1",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@vis.gl/react-google-maps": "1.10.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "firebase": "13.2.0",
    "geofire-common": "6.0.0",
    "lucide-react": "1.66.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/google.maps": "3.66.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
