{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 19090
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18081
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 14001
    },
    "singleProjectMode": true
  }
}
