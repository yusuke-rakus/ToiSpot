# 初期値は架空のdemoプロジェクトとローカルEmulatorだけを使用する。
# 起動: pnpm emulators（Docker Compose。Auth / Firestoreのみ）
VITE_USE_FIREBASE_EMULATORS=true

# ローカルの管理者Googleメール。pnpm seedだけが読み込む。VITE_は付けない。
# 設定後にpnpm seedを実行。Auth Emulatorでは同じメールの模擬アカウントを選択。
ADMIN_GOOGLE_EMAIL=admin@example.test

# 本番接続を実装・確認する時に設定する。ブラウザ用の公開設定値。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 地図・周辺コンビニ検索用。キー設定後は開発サーバーを再起動する。
# 通常キーではMaps JavaScript APIとPlaces API（New）を有効化し、両APIをキーの制限で許可する。
# Nearby Searchは地図ロードと別の課金対象。Demo Keyは対応範囲・日次上限内の試作用。
# 未設定なら設定案内を表示し、Maps APIへ接続しない。
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# trueで地図の移動・拡大縮小後に表示範囲を自動検索する。
# falseでは従来の半径3km・最大20件の手動検索を維持する。
VITE_PLACES_AUTO_SEARCH=false
# 自動モードのみ: 20件に達した範囲を分割して追加検索する。
VITE_PLACES_EXPANDED_SEARCH=true
# このズーム未満では手動検索・再試行・登録情報の取得も停止する。
VITE_PLACES_MIN_ZOOM=13
# 1回の検索のPlaces最大件数と最大API要求数（親領域の検索も含む）。
# 分割無効時は1要求・最大20件。Firestoreの周辺取得は別途最大100件。
VITE_PLACES_MAX_RESULTS=100
VITE_PLACES_MAX_REQUESTS=9
# 設定変更後は開発サーバーを再起動。本番は再ビルド・再デプロイが必要。
